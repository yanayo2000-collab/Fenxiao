# Copy this file to deploy/.env before running docker compose
# Example: cp deploy/.env.example deploy/.env

MYSQL_DATABASE=fenxiao
MYSQL_USER=fenxiao
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password

ADMIN_TOKEN=change-this-admin-token
ADMIN_SESSION_SECRET=change-this-independent-session-secret
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-this-one-time-bootstrap-password
ADMIN_BOOTSTRAP_DISPLAY_NAME=Super Admin
ADMIN_BOOTSTRAP_FORCE_PASSWORD_CHANGE=true
ADMIN_SESSION_TTL_MINUTES=720
ADMIN_REMEMBERED_IDLE_DAYS=7
ADMIN_LOGIN_WINDOW_MINUTES=10
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_ACCOUNT_LOCK_MINUTES=30
ADMIN_PASSWORD_MAX_AGE_DAYS=90
INTERNAL_DISTRIBUTION_TOKEN=change-this-internal-token
PROFILE_CREATE_TOKEN=change-this-profile-create-token
LINKY_SIGNING_SECRET=change-this-linky-signing-secret
LINKY_REPLAY_WINDOW_SECONDS=900
REWARD_ENGINE_ENABLED=false
REWARD_ENGINE_VERSION=BANDEIRA_V1_DIRECT_ONLY
LIFECYCLE_SHADOW_ONLY=true

WEB_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SERVER_PORT=8080
